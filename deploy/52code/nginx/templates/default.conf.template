# =============================================================================
# 52code 反向代理（nginx 镜像启动时用 envsubst 渲染为 /etc/nginx/conf.d/default.conf）
# 可替换变量：${EDGE_IP} 边缘机 IP；${SERVER_NAMES} 站点域名列表
# 代理参数对齐上游 deploy/Caddyfile：只信任实际对端生成转发头、流式响应不缓冲、
# 压缩排除 text/event-stream。
# =============================================================================

# 只信任边缘机传来的客户端 IP，其他来源一律按 TCP 对端处理
set_real_ip_from ${EDGE_IP};
real_ip_header X-Forwarded-For;
real_ip_recursive on;

# WebSocket 升级；普通请求清空 Connection 以复用上游长连接
map $http_upgrade $c52_connection {
    default upgrade;
    ''      '';
}

# 边缘机负责 TLS，默认按 https 告知应用；边缘机显式传了 X-Forwarded-Proto 则以它为准
map $http_x_forwarded_proto $c52_proto {
    default $http_x_forwarded_proto;
    ''      https;
}

upstream c52_app {
    server sub2api:8080;
    keepalive 256;
}

server {
    listen 80 default_server;
    server_name ${SERVER_NAMES};

    # 与应用 SERVER_MAX_REQUEST_BODY_SIZE（256MB）保持一致
    client_max_body_size 256m;

    # 压缩：不要用 text/*，否则 text/event-stream 会被缓冲到流结束
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_min_length 256;
    gzip_types text/css text/javascript text/plain text/xml text/markdown text/csv
               application/json application/javascript application/xml
               application/rss+xml image/svg+xml;

    # 容器健康检查用，不经过应用
    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location / {
        proxy_pass http://c52_app;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Proto $c52_proto;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $c52_connection;

        # LLM 流式响应：关闭缓冲，放宽读写超时
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_connect_timeout 10s;
        proxy_send_timeout 600s;
        proxy_read_timeout 600s;
    }
}
