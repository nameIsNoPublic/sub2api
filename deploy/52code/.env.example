# =============================================================================
# 52code 部署变量：复制为 .env 后修改（.env 已被 git 忽略）
# =============================================================================
# 这里只列 52code 关心的变量。应用其他变量（SMTP、网关参数等）名字与
# ../.env.example 完全一致，需要时直接追加到 .env。

# ---- 对外暴露（给边缘机） ----
# 宿主机绑定地址与端口：生产机绑公网 IP + 18080，由边缘机反代进来；本地联调改 127.0.0.1
BIND_HOST=38.46.220.136
PUBLIC_PORT=18080
# 边缘机 IP：nginx 只信任它传来的 X-Forwarded-For，防火墙脚本也只放行它。
# 边缘机买好前留空：防火墙会把 18080 对外全部拒绝，nginx 退回只信任 127.0.0.1。
EDGE_IP=
SERVER_NAMES=52code.ai www.52code.ai

# ---- 镜像（本仓库代码构建） ----
# 每次更新代码换一个标签再 build，方便回滚到上一个镜像
C52_IMAGE_TAG=local
C52_VERSION=
C52_COMMIT=docker
# 服务器在美国，用官方 Go 代理；在国内构建改回 https://goproxy.cn,direct 与 sum.golang.google.cn
GOPROXY=https://proxy.golang.org,direct
GOSUMDB=sum.golang.org
NPM_CONFIG_REGISTRY=

# ---- 基础 ----
TZ=Asia/Shanghai
SERVER_MODE=release

# ---- 数据库（独立容器，不与同机其他项目共用） ----
POSTGRES_USER=sub2api
POSTGRES_PASSWORD=change_this_secure_password
POSTGRES_DB=sub2api
POSTGRES_MAX_CONNECTIONS=1024
POSTGRES_SHARED_BUFFERS=2GB
POSTGRES_EFFECTIVE_CACHE_SIZE=8GB
POSTGRES_MAINTENANCE_WORK_MEM=256MB

# ---- Redis（独立容器） ----
REDIS_PASSWORD=change_this_redis_password
